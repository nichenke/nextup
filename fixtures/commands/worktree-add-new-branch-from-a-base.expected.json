{
	"description": "A worktree for a branch that does not exist yet, cut from the commit a --base resolved to rather than from the primary checkout's HEAD.",
	"input": {
		"repo": "/repo",
		"path": "/repo/.worktrees/reader-8",
		"branch": "feature/reader-8",
		"create": true,
		"startPoint": "0123456789abcdef0123456789abcdef01234567"
	},
	"argv": [
		"git",
		"-C",
		"/repo",
		"worktree",
		"add",
		"/repo/.worktrees/reader-8",
		"-b",
		"feature/reader-8",
		"0123456789abcdef0123456789abcdef01234567"
	]
}
